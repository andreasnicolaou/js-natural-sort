{
  "name": "@andreasnicolaou/js-natural-sort",
  "version": "2.0.0",
  "description": "Natural sort comparator for JavaScript and TypeScript: numbers, dates, IP addresses and hex values, with case-insensitive, descending and key-based sorting.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js",
    "umd": "./dist/index.umd.js",
    "umd-min": "./dist/index.umd.min.js"
  },
  "private": false,
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.umd.js",
    "dist/index.umd.min.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "test": "jest",
    "test:ci": "cross-env JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --reporters=default --reporters=jest-junit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:bundle": "npx bundlewatch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andreasnicolaou/js-natural-sort.git"
  },
  "bugs": {
    "url": "https://github.com/andreasnicolaou/js-natural-sort/issues"
  },
  "author": {
    "name": "Andreas Nicolaou",
    "email": "anicolaou66@gmail.com"
  },
  "license": "MIT",
  "bundlewatch": {
    "files": [
      {
        "path": "dist/index.js",
        "maxSize": "4kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.cjs",
        "maxSize": "4kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.umd.js",
        "maxSize": "4kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.umd.min.js",
        "maxSize": "2kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.d.ts",
        "maxSize": "2kB",
        "compression": "none"
      },
      {
        "path": "dist/index.esm.js",
        "maxSize": "4kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.cjs.js",
        "maxSize": "4kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.amd.js",
        "maxSize": "4kB",
        "compression": "gzip"
      }
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.(ts)$": [
        "ts-jest"
      ]
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "bundlewatch": "^0.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "prettier": "3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "natural-sort",
    "natural-sorting",
    "sort",
    "sorter",
    "sorting",
    "comparator",
    "alphanumeric",
    "javascript",
    "typescript",
    "array",
    "numeric",
    "date",
    "datetime",
    "desc",
    "case-insensitive"
  ]
}
